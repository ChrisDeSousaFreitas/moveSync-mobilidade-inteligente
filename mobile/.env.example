# URL da API. Em emulador Android, 10.0.2.2 aponta para o computador host.
# No Expo Go em celular físico, use o IP local do computador (ex.: http://192.168.0.10:8080/api).
EXPO_PUBLIC_API_URL=http://192.168.15.2/api

# Chave Google Maps para builds nativos (Android/iOS). Nunca publique a chave real no Git.
EXPO_PUBLIC_MAPS_API_KEY=
