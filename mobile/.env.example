# URL da API. Em emulador Android, 10.0.2.2 aponta para o computador host.
# No Expo Go em celular físico, use o IP local do computador e a porta 8080.
EXPO_PUBLIC_API_URL=http://192.168.0.10:8080/api

# Chave do Google Maps para builds Android próprios (não é necessária no Expo Go).
# Ative "Maps SDK for Android" no Google Cloud e configure a chave no ambiente local.
# Nunca publique a chave real no Git.
EXPO_PUBLIC_MAPS_API_KEY=
